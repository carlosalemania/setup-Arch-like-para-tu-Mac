# Tokyo Night Storm Theme for btop
# Azules profundos con acentos neón rosa/naranja
# Elegante y moderno

# Main background - Azul noche profundo
theme[main_bg]="#24283b"

# Main text color - Gris azulado claro
theme[main_fg]="#c0caf5"

# Title color - Rosa neón
theme[hi_fg]="#ff007c"

# Highlight color
theme[title]="#7aa2f7"

# Selected item background
theme[selected_bg]="#2d3149"

# Selected item foreground - Rosa brillante
theme[selected_fg]="#bb9af7"

# Inactive text - Azul grisáceo
theme[inactive_fg]="#565f89"

# Graph text
theme[graph_text]="#c0caf5"

# Meter background
theme[meter_bg]="#1f2335"

# Misc colors
theme[proc_misc]="#7dcfff"

# Box colors
theme[cpu_box]="#bb9af7"
theme[mem_box]="#7aa2f7"
theme[net_box]="#9ece6a"
theme[proc_box]="#ff9e64"

# Divider line
theme[div_line]="#414868"

# Temperature graph
theme[temp_start]="#9ece6a"
theme[temp_mid]="#e0af68"
theme[temp_end]="#f7768e"

# CPU graph - Púrpura a azul
theme[cpu_start]="#bb9af7"
theme[cpu_mid]="#7aa2f7"
theme[cpu_end]="#7dcfff"

# Mem/Disk free - Azul cielo
theme[free_start]="#7dcfff"
theme[free_mid]="#7aa2f7"
theme[free_end]="#565f89"

# Mem/Disk cached - Verde esmeralda
theme[cached_start]="#73daca"
theme[cached_mid]="#7dcfff"
theme[cached_end]="#9ece6a"

# Mem/Disk available - Púrpura suave
theme[available_start]="#bb9af7"
theme[available_mid]="#9d7cd8"
theme[available_end]="#7aa2f7"

# Mem/Disk used - Rosa a naranja
theme[used_start]="#f7768e"
theme[used_mid]="#ff9e64"
theme[used_end]="#e0af68"

# Download - Verde matrix suave
theme[download_start]="#9ece6a"
theme[download_mid]="#73daca"
theme[download_end]="#7dcfff"

# Upload - Naranja a rojo suave
theme[upload_start]="#ff9e64"
theme[upload_mid]="#ff757f"
theme[upload_end]="#f7768e"

# Process gradient
theme[process_start]="#bb9af7"
theme[process_mid]="#7aa2f7"
theme[process_end]="#7dcfff"
