#!/bin/bash

# 🔥 BORDERS CONFIG - ROSA NEÓN ÉPICO
# Creado por: Carlos Alemania

options=(
    # Estilo del borde
    style=round

    # Ancho del borde (en píxeles)
    width=6.0

    # COLORES ÉPICOS
    # Ventana activa: Rosa neón profundo con transparencia
    active_color=0xffff0080

    # Ventana inactiva: Gris oscuro suave
    inactive_color=0x40808080

    # Difuminado del borde
    blur_radius=8.0

    # Offset del borde
    ax=4
    ay=4

    # Hidpi (para pantallas Retina)
    hidpi=on

    # Blacklist (apps donde no mostrar bordes)
    blacklist="System Preferences,System Settings,Finder"
)

borders "${options[@]}"
